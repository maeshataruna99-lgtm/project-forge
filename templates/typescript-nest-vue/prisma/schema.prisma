generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id    String        @id @default(cuid())
  name  String
  items ExampleItem[]
  /*__AUTH_COMPANY_RELATION__*/
  /*__AUDIT_COMPANY_RELATION__*/
}

model ExampleItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  title     String

  @@index([companyId])
}

/*__AUTH_PRISMA_SCHEMA__*/
/*__ECOMMERCE_PRISMA_SCHEMA__*/
